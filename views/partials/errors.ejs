<% if (typeof errors !=='undefined' && errors.length> 0) { %>
    <div role="alert" class="bg-red-50 border border-red-200 border-l-4 border-l-red-500 rounded-lg p-4">
        <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-red-500 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd"
                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z"
                    clip-rule="evenodd" />
            </svg>
            <p class="text-sm font-semibold text-red-800">Please fix the following <%= errors.length===1 ? 'error'
                    : 'errors' %>:</p>
        </div>
        <ul class="list-disc pl-9 space-y-1 text-sm text-red-700">
            <% errors.forEach(error=> { %>
                <li>
                    <%= error %>
                </li>
                <% }) %>
        </ul>
    </div>
    <% } %>